  command = C:\Windows\system32\cmd.exe /C "$PRE_LINK && ccache C:\ncs\toolchains\dcbdc366a1\opt\bin\cmake.exe -E rm -f $TARGET_FILE && ccache C:\ncs\toolchains\dcbdc366a1\opt\zephyr-sdk\gnu\arm-zephyr-eabi\bin\arm-zephyr-eabi-ar.exe qc $TARGET_FILE $LINK_FLAGS $in && ccache C:\ncs\toolchains\dcbdc366a1\opt\zephyr-sdk\gnu\arm-zephyr-eabi\bin\arm-zephyr-eabi-ranlib.exe $TARGET_FILE && $POST_BUILD"
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = C:\ncs\toolchains\dcbdc366a1\opt\bin\cmake.exe --regenerate-during-build -SC:\nordic\knx_workshop\solution\sensor -BC:\nordic\knx_workshop\solution\sensor\_build\sensor
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = C:\ncs\toolchains\dcbdc366a1\opt\bin\cmake.exe -DCONFIG=$CONFIG -P CMakeFiles\clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = C:\ncs\toolchains\dcbdc366a1\opt\bin\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = C:\ncs\toolchains\dcbdc366a1\opt\bin\ninja.exe -t targets
  description = All primary targets available:

